# ---- Server (on Render: the service's Environment tab) ----

# Muse key from the Meta Model API. Required.
META_MODEL_API_KEY=
# Standard tier only; contributor tiers (which let Meta train on prompts) are refused.
META_MODEL=muse-spark-1.3
# Optional Postgres for the App Store cache. Memory if empty.
DATABASE_URL=
# Per visitor, per hour. One full run is 4 AI calls.
AI_CALLS_PER_HOUR=30
# Across all visitors, per day.
AI_CALLS_PER_DAY=300

# Optional: Claude instead of Muse.
# AI_PROVIDER=claude
# ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5

# ---- Web app ----
# Only when the API is on a different origin from the web app.
# VITE_API_URL=https://your-api.onrender.com

{
  "name": "spinoff",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit && deno check server/main.ts dev/server.ts",
    "api:dev": "deno run -A dev/server.ts",
    "api:demo": "deno run -A dev/server.ts --fixtures",
    "start": "DENO_DIR=.deno DENO_NO_PACKAGE_JSON=1 deno run --allow-net --allow-env --allow-read server/main.ts",
    "test": "deno test -A tests/",
    "render-build": "npm ci && npm run build && DENO_DIR=.deno DENO_NO_PACKAGE_JSON=1 deno cache server/main.ts"
  },
  "dependencies": {
    "@fontsource/instrument-serif": "^5.3.0",
    "deno": "^2.9.6",
    "lucide-react": "^0.545.0",
    "react": "~19.1.0",
    "react-dom": "~19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^25.3.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "tailwindcss": "^4.1.14",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.2"
  },
  "engines": {
    "node": ">=20"
  }
}
